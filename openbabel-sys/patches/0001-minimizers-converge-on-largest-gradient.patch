+  // Squared length of one atom's gradient, g[0..2], for the minimizers'
+  // convergence test: every atom must be at rest (largest squared gradient
+  // below _gconv). A gradient that is not finite is as far from rest as it
+  // gets, so it reports infinity rather than letting the max skip it.
+  static double AtomGradient2(const double *g)
+  {
+    const double g2 = g[0] * g[0] + g[1] * g[1] + g[2] * g[2];
+    return isfinite(g2) ? g2 : HUGE_VAL;
+  }
